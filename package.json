{
  "name": "personal-website",
  "homepage": "https://brandonbowen.net",
  "version": "1.0.0",
  "description": "my personal site",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "prebuild": "ts-node --project scripts/tsconfig.json scripts/generate-content-graph.ts",
    "build": "next build",
    "postbuild": "node scripts/generate-sitemap.mjs",
    "start": "next start",
    "lint": "next lint",
    "seed": "ts-node --project tsconfig.json scripts/seed-content.ts"
  },
  "dependencies": {
    "@apollo/client": "^4.0.7",
    "@apollo/server": "^5.0.0",
    "@as-integrations/next": "^4.0.0",
    "@emailjs/browser": "^4.4.1",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^15.5.5",
    "@next/third-parties": "^15.5.4",
    "@types/mdx": "^2.0.13",
    "graphql": "^16.11.0",
    "graphql-tag": "^2.12.6",
    "gray-matter": "^4.0.3",
    "next": "^15.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-google-recaptcha": "^3.1.0",
    "react-icons": "^5.5.0",
    "rehype-pretty-code": "^0.14.1",
    "rehype-slug": "^6.0.0",
    "shiki": "^3.13.0",
    "swiper": "^12.0.2",
    "typed.js": "^2.1.0"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.28.4",
    "@types/node": "^24.7.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@types/react-google-recaptcha": "^2.1.9",
    "eslint": "^9.37.0",
    "eslint-config-next": "^15.5.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "eslintConfig": {
    "extends": [
      "eslint:recommended",
      "next/core-web-vitals"
    ],
    "rules": {
      "react/no-unescaped-entities": "off",
      "@next/next/no-page-custom-font": "off",
      "@next/next/no-img-element": "off",
      "no-unused-vars": "warn"
    }
  }
}
